    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nfor (const item of items) {\n    const safeClone = { ...item.json };\n    delete safeClone.__savedInput;\n    \n    item.json.__savedInput = safeClone;\n    results.push(item);\n    \n    await new Promise(resolve => setTimeout(resolve, 2000));\n}\nreturn results;"
      },
