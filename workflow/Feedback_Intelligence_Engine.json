      ],
      "id": "fb1ff184-0c51-4d4f-a620-9e481dd79ad7",
      "name": "Validation"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst backupItems = $('Backup Original Data').all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const httpResponse = items[i].json;\n  const originalData = backupItems[i] ? backupItems[i].json : {};\n\n  let aiString = httpResponse.choices[0].message.content;\n  aiString = aiString.trim();\n  if (aiString.startsWith('```json')) aiString = aiString.replace(/```json\\n?/, '');\n  if (aiString.endsWith('```')) aiString = aiString.replace(/```$/, '');\n  if (aiString.startsWith('json\\n')) aiString = aiString.replace('json\\n', '');\n  aiString = aiString.trim();\n\n  let parsedAI;\n  let finalData;\n  try {\n    parsedAI = JSON.parse(aiString);\n  } catch (error) {\n    finalData = {\n      error: \"Malformed AI JSON\",\n      rawAiResponse: aiString,\n      route: \"NeedsReview\",\n      ...originalData\n    };\n    results.push({ json: finalData });\n    continue;\n  }\n\n  const requiredKeys = ['sentiment', 'category', 'urgency_score', 'confidence_score', 'action_item', 'coordinator_reply_draft'];\n  const missingKeys = requiredKeys.filter(key => !(key in parsedAI));\n  if (missingKeys.length > 0) {\n    finalData = {\n      error: `Missing keys: ${missingKeys.join(', ')}`,\n      rawAiResponse: aiString,\n      route: \"NeedsReview\",\n      ...originalData\n    };\n    results.push({ json: finalData });\n    continue;\n  }\n\n  parsedAI.urgency_score = Number(parsedAI.urgency_score);\n  parsedAI.confidence_score = Number(parsedAI.confidence_score);\n\n  finalData = {\n    ...originalData, \n    ...parsedAI,\n    route: \"Process\",\n    rawAiResponse: aiString,\n    error: null\n  };\n  results.push({ json: finalData });\n}\nreturn results;"
      },
