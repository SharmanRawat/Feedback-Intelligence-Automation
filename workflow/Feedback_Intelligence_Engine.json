    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nconst emailMap = {\n  \"Venue\": \"sharmanrawat495@gmail.com\",\n  \"Speaker\": \"sharmanrawat495@gmail.com\",\n  \"Logistics\": \"sharmanrawat495@gmail.com\",\n  \"Technical\": \"sharmanrawat495@gmail.com\",\n  \"Content\": \"sharmanrawat495@gmail.com\",\n  \"Other\": \"sharmanrawat495@gmail.com\"\n};\n\nfor (const item of items) {\n  const data = item.json;\n  data.coordinatorEmail = emailMap[data.category] || \"coordinator@college.edu\";\n\n  const sentiment = data.sentiment ? data.sentiment.toLowerCase() : 'neutral';\n  const urgency = data.urgency_score || 1;\n  const confidence = data.confidence_score || 1;\n\n  let finalRoute = 'NeedsReview'; \n\n  if (sentiment === 'positive') {\n    finalRoute = 'Testimonials';\n  } else if (sentiment === 'negative' && urgency >= 4) {\n    finalRoute = 'HighPriorityEmail';\n  } else if (sentiment === 'negative' && urgency <= 3) {\n    finalRoute = 'ActionItemsAndNormalEmail';\n  } else if (sentiment === 'neutral' || sentiment === 'mixed' || confidence < 6) {\n    finalRoute = 'NeedsReview';\n  }\n\n  data.finalRoute = finalRoute;\n  results.push({ json: data });\n}\nreturn results;"
      },
