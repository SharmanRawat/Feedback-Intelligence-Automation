        "jsonBody": "={{ JSON.stringify({ model: \"llama-3.3-70b-versatile\", messages: [{ role: \"system\", content: \"You are a strict JSON-only AI. Analyze the sentiment. If it has only praise, it is Positive. If it has only complaints, it is Negative. If it has both, it is Mixed. If it says 'it was fine' or is vague, it is Neutral. Return ONLY a valid JSON object following this exact schema: { \\\"sentiment\\\": \\\"Positive | Negative | Neutral | Mixed\\\", \\\"category\\\": \\\"Venue | Speaker | Content | Logistics | Technical | Other\\\", \\\"urgency_score\\\": integer (1 to 5), \\\"confidence_score\\\": integer (1 to 10), \\\"action_item\\\": string or null, \\\"coordinator_reply_draft\\\": string }\" }, { role: \"user\", content: \"Feedback: \" + $json[\"Feedback Test\"] + \". Event: \" + $json[\"Event name\"] + \". Student: \" + $json[\"Student Name\"] + \".\" }], response_format: { type: \"json_object\" }, temperature: 0 }) }}",
