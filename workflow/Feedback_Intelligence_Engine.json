    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nfor (const item of items) {\n  const data = item.json;\n  const feedbackText = data[\"Feedback Test\"] || \"\";\n  \n  const isGibberish = !/[a-zA-Z]{3,}/.test(feedbackText);\n  \n  if (!feedbackText || feedbackText.length < 5 || isGibberish) {\n    results.push({ json: { ...data, valid: false } });\n  } else {\n    results.push({ json: { ...data, valid: true } });\n  }\n}\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
